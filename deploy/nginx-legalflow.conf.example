server {
    listen 80;
    listen [::]:80;
    server_name legalflow.lucianoferreiradev.com;

    root /var/www/legalflow/frontend/dist;
    index index.html;
    client_max_body_size 10m;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Laravel API served by PHP-FPM in Docker.
    location ^~ /api/ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/legalflow/backend/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/legalflow/backend/public;
        fastcgi_pass 127.0.0.1:9000;
    }

    location ~ \.php$ {
        return 404;
    }
}
