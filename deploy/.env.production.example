# Copie para .env.production e preencha os valores reais.
# Nunca envie o arquivo .env.production ao GitHub.

APP_NAME=LegalFlow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://legalflow.lucianoferreiradev.com
FRONTEND_URL=https://legalflow.lucianoferreiradev.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=legalflow
DB_USERNAME=legalflow
DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
MYSQL_ROOT_PASSWORD=SUBSTITUA_POR_OUTRA_SENHA_FORTE

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
